# Spotify API (vereist)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# OpenAI (vereist)
OPENAI_API_KEY=your_openai_key
# Optioneel: modellen en gedrag van de generatie
OPENAI_MODEL=gpt-4o
OPENAI_SCORE_MODEL=gpt-4o-mini
# Instagram-plaatjes: beeldmodel voor de achtergrondillustratie (INSTAGRAM_AI_ILLUSTRATIE=0 = zelf getekend)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
INSTAGRAM_AI_ILLUSTRATIE=1
# AI-afwerking: plaatje opnieuw laten tekenen, tekst laten controleren (0 = alleen het strakke plaatje)
INSTAGRAM_AI_AFWERKING=1
# Welke plaatjes per rotatie: IN, OUT of IN,OUT
INSTAGRAM_RICHTINGEN=IN
INSTAGRAM_AFWERKING_QUALITY=high
INSTAGRAM_AFWERKING_POGINGEN=2
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_CONTROLE_MODEL=gpt-4o
SUGGESTIES_PER_CATEGORIE=5
MAX_REASKS=2
BLOK_ACCEPT_RATIO=0.8
DISCOVERY_MAX_MAANDEN=3
DISCOVERY_EXPIRE_DAGEN=30
# Populariteitsvakken (Spotify popularity 0-100) als 'Spreid populariteit' aan staat
POPULARITEIT_VAKKEN=30-50,50-70,70-80,80-90,90-100
# NL-radiolijsten: score van de laatste plek, en grootte van het keuzemenu per categorie
RADIO_SCORE_MIN=30
RADIO_KANDIDATEN_PER_CATEGORIE=25

# Scheduler-tijdzone (default Europe/Amsterdam)
TZ=Europe/Amsterdam

# Toegang tot de app (sterk aanbevolen; zonder APP_PASSWORD staat alles open)
APP_PASSWORD=
# Optioneel: vaste sleutel voor de sessie-cookie (anders afgeleid van APP_PASSWORD)
SECRET_KEY=
# Alarm-mail bij mislukte rotaties (anders: eerste wissellijst met mail aan)
ALERT_MAIL=

# E-mail notificaties (optioneel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
