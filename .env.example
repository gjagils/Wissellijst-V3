# Spotify API (vereist)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# OpenAI (vereist)
OPENAI_API_KEY=your_openai_key
# Optioneel: modellen en gedrag van de generatie
OPENAI_MODEL=gpt-4o
OPENAI_SCORE_MODEL=gpt-4o-mini
SUGGESTIES_PER_CATEGORIE=5
MAX_REASKS=2
BLOK_ACCEPT_RATIO=0.8
DISCOVERY_MAX_MAANDEN=3
DISCOVERY_EXPIRE_DAGEN=30
# Populariteitsvakken (Spotify popularity 0-100) als 'Spreid populariteit' aan staat
POPULARITEIT_VAKKEN=30-50,50-70,70-80,80-90,90-100

# Scheduler-tijdzone (default Europe/Amsterdam)
TZ=Europe/Amsterdam

# Toegang tot de app (sterk aanbevolen; zonder APP_PASSWORD staat alles open)
APP_PASSWORD=
# Optioneel: vaste sleutel voor de sessie-cookie (anders afgeleid van APP_PASSWORD)
SECRET_KEY=
# Alarm-mail bij mislukte rotaties (anders: eerste wissellijst met mail aan)
ALERT_MAIL=

# E-mail notificaties (optioneel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
